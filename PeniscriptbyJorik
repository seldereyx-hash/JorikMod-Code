local function playSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. soundId
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

-- Анимация кнопок
local function addHoverAnimation(button, defaultColor)
    button:SetAttribute("OriginalColor", defaultColor or Colors.Button)
    button.BackgroundColor3 = defaultColor or Colors.Button
    button.MouseEnter:Connect(function()
        if button:GetAttribute("IsActive") ~= true then
            TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Colors.ButtonHover}):Play()
        end
    end)
    button.MouseLeave:Connect(function()
        if button:GetAttribute("IsActive") ~= true then
            TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = button:GetAttribute("OriginalColor")}):Play()
        end
    end)
end

