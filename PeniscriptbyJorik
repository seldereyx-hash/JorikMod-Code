local function createControl(labelText, defaultValue, min, max, offset, callback)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0.9, 0, 0, 45)
    Container.Position = UDim2.new(0.05, 0, 0, offset)
    Container.BackgroundTransparency = 1
    Container.Parent = ControlsScroll

    local Display = Instance.new("TextLabel")
    Display.Size = UDim2.new(1, 0, 0, 16)
    Display.Text = labelText .. ": " .. tostring(defaultValue)
    Display.BackgroundTransparency = 1
    Display.TextColor3 = Colors.Text
    Display.Font = Enum.Font.GothamSemibold
    Display.TextSize = 11
    Display.Parent = Container

    local DecreaseButton = Instance.new("TextButton")
    DecreaseButton.Size = UDim2.new(0.18, 0, 0, 20)
    DecreaseButton.Position = UDim2.new(0, 0, 0.45, 0)
    DecreaseButton.Text = "-"
    DecreaseButton.TextColor3 = Colors.Text
    DecreaseButton.Font = Enum.Font.GothamBold
    DecreaseButton.TextSize = 12
    DecreaseButton.Parent = Container
    local DC = Instance.new("UICorner") DC.CornerRadius = UDim.new(0, 5) DC.Parent = DecreaseButton
    addHoverAnimation(DecreaseButton)

    local IncreaseButton = Instance.new("TextButton")
    IncreaseButton.Size = UDim2.new(0.18, 0, 0, 20)
    IncreaseButton.Position = UDim2.new(0.82, 0, 0.45, 0)
    IncreaseButton.Text = "+"
    IncreaseButton.TextColor3 = Colors.Text
    IncreaseButton.Font = Enum.Font.GothamBold
    IncreaseButton.TextSize = 12
    IncreaseButton.Parent = Container
    local IC = Instance.new("UICorner") IC.CornerRadius = UDim.new(0, 5) IC.Parent = IncreaseButton
    addHoverAnimation(IncreaseButton)

    local TextBox = Instance.new("TextBox")
    TextBox.Size = UDim2.new(0.55, 0, 0, 20)
    TextBox.Position = UDim2.new(0.22, 0, 0.45, 0)
    TextBox.PlaceholderText = "Введи..."
    TextBox.BackgroundColor3 = Colors.Header
    TextBox.TextColor3 = Colors.Text
    TextBox.Font = Enum.Font.Gotham
    TextBox.TextSize = 10
    TextBox.Parent = Container
    local TC = Instance.new("UICorner") TC.CornerRadius = UDim.new(0, 5) TC.Parent = TextBox

    local currentVal = type(defaultValue) == "number" and defaultValue or 0

    local function updateValue(newValue)
        if type(defaultValue) == "number" then
            if min and max then
                newValue = math.clamp(newValue, min, max)
            end
            currentVal = newValue
            Display.Text = labelText .. ": " .. newValue
            callback(newValue)
        else
            Display.Text = labelText .. ": Установлен"
            callback(newValue)
        end
    end

    DecreaseButton.MouseButton1Click:Connect(function()
        if type(defaultValue) == "number" then updateValue(currentVal - 1) end
        playSound("12221967")
    end)

    IncreaseButton.MouseButton1Click:Connect(function()
        if type(defaultValue) == "number" then updateValue(currentVal + 1) end
        playSound("12221967")
    end)

    TextBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            if type(defaultValue) == "number" then
                local newValue = tonumber(TextBox.Text)
                if newValue then updateValue(newValue) end
            else
                local r, g, b = TextBox.Text:match("(%d+),%s*(%d+),%s*(%d+)")
                if r and g and b then
                    updateValue(Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)))
                end
            end
            TextBox.Text = ""
            playSound("12221967")
        end
    end)
end

