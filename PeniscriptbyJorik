-- ФУНКЦИЯ СОЗДАНИЯ ФИЗИЧЕСКОГО ОБЪЕКТА
local function spawnPhysicsPenis()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    if not root then return end

    local old = char:FindFirstChild("PhysicsPenis")
    if old then old:Destroy() end

    local model = Instance.new("Model")
    model.Name = "PhysicsPenis"
    model.Parent = char

    local diameter = 0.45
    local segmentLength = 0.65

    -- Настройка NoCollisionConstraints, чтобы хитбоксы не толкали самого игрока
    local function ignoreCharacterCollisions(part)
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("BasePart") then
                local ncc = Instance.new("NoCollisionConstraint")
                ncc.Part0 = part
                ncc.Part1 = child
                ncc.Parent = part
            end
        end
    end

    -- Вспомогательная функция сборки сегментов (Смотрит строго вперед по оси Z)
    local function createSegment(name, positionOffset, parentAttachment)
        local part = Instance.new("Part")
        part.Name = name
        part.Color = PenisConfig.MainColor
        part.Material = Enum.Material.SmoothPlastic
        
        if PenisConfig.Shape == "Cylinder" then
            part.Shape = Enum.PartType.Cylinder
            part.Size = Vector3.new(segmentLength, diameter, diameter)
        else
            part.Shape = Enum.PartType.Block
            part.Size = Vector3.new(diameter, diameter, segmentLength)
        end
        
        -- Включаем хитбоксы
        part.CanCollide = true
        part.Massless = true
        
        -- Выравниваем CFrame: направляем строго по центру вперед
        if PenisConfig.Shape == "Cylinder" then
            part.CFrame = root.CFrame * CFrame.new(positionOffset) * CFrame.Angles(0, math.rad(90), 0)
        else
            part.CFrame = root.CFrame * CFrame.new(positionOffset)
        end
        
        ignoreCharacterCollisions(part)
        part.Parent = model

        local attSelf = Instance.new("Attachment")
        if PenisConfig.Shape == "Cylinder" then
            attSelf.Position = Vector3.new(-segmentLength/2, 0, 0)
        else
            attSelf.Position = Vector3.new(0, 0, segmentLength/2)
        end
        attSelf.Parent = part

        local bsc = Instance.new("BallSocketConstraint")
        bsc.Attachment0 = parentAttachment
        bsc.Attachment1 = attSelf
        bsc.LimitsEnabled = true
        -- В режиме Dripping уменьшаем углы свободного хода, чтобы член стоял жестче
        bsc.UpperAngle = PenisConfig.Dripping and 5 or 35
        bsc.Parent = part

        local spring = Instance.new("SpringConstraint")
        spring.Attachment0 = parentAttachment
        spring.Attachment1 = attSelf
        -- В режиме Dripping задираем жесткость до максимума для эффекта эрекции
        spring.Stiffness = PenisConfig.Dripping and 4500 or 250
        spring.Damping = PenisConfig.Dripping and 40 or 12
        spring.FreeLength = 0
        spring.Parent = part

        local attNext = Instance.new("Attachment")
        if PenisConfig.Shape == "Cylinder" then
            attNext.Position = Vector3.new(segmentLength/2, 0, 0)
        else
            attNext.Position = Vector3.new(0, 0, -segmentLength/2)
        end
        attNext.Parent = part

        return part, attNext
    end

    -- Создание основы (яиц)
    local leftBall = Instance.new("Part")
    leftBall.Name = "LeftBall"
    leftBall.Shape = Enum.PartType.Ball
    leftBall.Size = Vector3.new(0.65, 0.65, 0.65)
    leftBall.Color = PenisConfig.MainColor
    leftBall.CanCollide = true
    leftBall.Massless = true
    leftBall.CFrame = root.CFrame * CFrame.new(-0.25, -0.6, -0.4)
    ignoreCharacterCollisions(leftBall)
    leftBall.Parent = model
    local w1 = Instance.new("WeldConstraint", leftBall) w1.Part0 = root w1.Part1 = leftBall

    local rightBall = Instance.new("Part")
    rightBall.Name = "RightBall"
    rightBall.Shape = Enum.PartType.Ball
    rightBall.Size = Vector3.new(0.65, 0.65, 0.65)
    rightBall.Color = PenisConfig.MainColor
    rightBall.CanCollide = true
    rightBall.Massless = true
    rightBall.CFrame = root.CFrame * CFrame.new(0.25, -0.6, -0.4)
    ignoreCharacterCollisions(rightBall)
    rightBall.Parent = model
    local w2 = Instance.new("WeldConstraint", rightBall) w2.Part0 = root w2.Part1 = rightBall

    -- Начальный корневой аттачмент строго по центру спереди
    local currentAttachment = Instance.new("Attachment")
    currentAttachment.Position = Vector3.new(0, -0.45, -0.55)
    currentAttachment.Parent = root

    -- Строим цепочку
    local lastPart = nil
    for i = 1, PenisConfig.Length do
        local offsetZ = -0.55 - (i * (segmentLength * 0.9))
        local part, nextAtt = createSegment("Segment_" .. i, Vector3.new(0, -0.45, offsetZ), currentAttachment)
        lastPart = part
        currentAttachment = nextAtt
    end

    -- Головка приварена жестко
    if lastPart then
        local tip = Instance.new("Part")
        tip.Name = "Tip"
        tip.Shape = Enum.PartType.Ball
        tip.Size = Vector3.new(diameter * 1.2, diameter * 1.2, diameter * 1.2)
        tip.Color = PenisConfig.TipColor
        tip.CanCollide = true
        tip.Massless = true
        
        if PenisConfig.Shape == "Cylinder" then
            tip.CFrame = lastPart.CFrame * CFrame.new(segmentLength / 2 + 0.1, 0, 0)
        else
            tip.CFrame = lastPart.CFrame * CFrame.new(0, 0, -segmentLength / 2 - 0.1)
        end
        
        ignoreCharacterCollisions(tip)
        tip.Parent = model

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = lastPart
        weld.Part1 = tip
        weld.Parent = tip
    end
end

