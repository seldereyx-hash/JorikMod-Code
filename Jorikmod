local function updateTPPlayerList()
    for _, child in ipairs(TPPlayerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton", TPPlayerList)
            pBtn.Size = UDim2.new(1, -6, 0, 24)
            pBtn.BackgroundColor3 = Color3.fromRGB(45, 30, 65)
            pBtn.TextColor3 = Theme.Text
            pBtn.Text = "ТП к: " .. player.DisplayName
            pBtn.Font = Enum.Font.SourceSans
            pBtn.TextSize = 12
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            pBtn.MouseButton1Click:Connect(function()
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    safeFlyTeleport(player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3))
                end
            end)
        end
    end
end

