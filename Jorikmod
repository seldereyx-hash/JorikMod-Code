local isMenuOpen = false
local isAnimating = false

local function toggleMenu()
    if isAnimating then return end
    isAnimating = true
    isMenuOpen = not isMenuOpen

    if isMenuOpen then
        MainFrame.Visible = true
        TweenService:Create(MainScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        local tweenAlpha = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0})
        tweenAlpha:Play()
        tweenAlpha.Completed:Connect(function() isAnimating = false end)
    else
        TweenService:Create(MainScale, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.7}):Play()
        local tweenAlpha = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
        tweenAlpha:Play()
        tweenAlpha.Completed:Connect(function()
            MainFrame.Visible = false
            isAnimating = false
        end)
    end
end

