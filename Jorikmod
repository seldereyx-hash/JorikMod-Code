LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid"); char:WaitForChild("HumanoidRootPart")
    task.wait(0.5)
    if currentSpeed ~= 16 and char:FindFirstChildOfClass("Humanoid") then
        char:FindFirstChildOfClass("Humanoid").WalkSpeed = currentSpeed
    end
    if currentGravity ~= 196.2 then Workspace.Gravity = currentGravity end
    if Flying then startFly() end
    if FlyV2Enabled then startFlyV2() end
    if ESPEnabled then for _, p in ipairs(Players:GetPlayers()) do setupESP(p) end end
    if InvisibleEnabled then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") or p:IsA("Decal") then p.Transparency = 1 end
        end
    end
end)

