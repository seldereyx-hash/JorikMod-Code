local function getMobileMoveDirection()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if hum and hum.MoveDirection.Magnitude > 0 then return hum.MoveDirection.Unit end
    return Vector3.zero
end

local function startFly()
    Flying = true
    FlyControls.Visible = true
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")
    
    FlyConnection = RunService.RenderStepped:Connect(function()
        if not Flying then return end
        humanoid.PlatformStand = true
        local moveDirection = getMobileMoveDirection() * 50
        local vertical = 0
        if goUp then vertical = 40 elseif goDown then vertical = -40 end
        hrp.Velocity = Vector3.new(moveDirection.X, vertical, moveDirection.Z)
    end)
end

local function stopFly()
    Flying = false
    FlyControls.Visible = false
    if FlyConnection then FlyConnection:Disconnect(); FlyConnection = nil end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.PlatformStand = false
    end
end

local function startFlyV2()
    FlyV2Enabled = true
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local hrp = character:WaitForChild("HumanoidRootPart")
    
    local function getIYDirection()
        local dir = getMobileMoveDirection()
        if dir.Magnitude == 0 then return Vector3.zero end
        local camCFrame = Camera.CFrame
        return (camCFrame.RightVector * (dir.X) + camCFrame.LookVector * (-dir.Z)).Unit
    end

    FlyV2Connection = RunService.RenderStepped:Connect(function()
        if not FlyV2Enabled then return end
        humanoid.PlatformStand = true
        local flyDir = getIYDirection()
        hrp.Velocity = flyDir * flyV2Speed
    end)
end

local function stopFlyV2()
    FlyV2Enabled = false
    if FlyV2Connection then FlyV2Connection:Disconnect(); FlyV2Connection = nil end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.PlatformStand = false
    end
end

