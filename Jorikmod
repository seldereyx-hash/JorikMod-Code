RingVisualButton.MouseButton1Click:Connect(function()
    RingVisualEnabled = not RingVisualEnabled; setToggleState(RingVisualButton, RingVisualEnabled)
    if RingVisualEnabled then
        table.clear(ringVisualParts); table.clear(ringVisualAngles)
        local count = 0
        for _, p in ipairs(Workspace:GetDescendants()) do
            if count >= 150 then break end
            if p:IsA("BasePart") and not p.Anchored and p.Parent and p.Parent ~= LocalPlayer.Character then
                table.insert(ringVisualParts, p); table.insert(ringVisualAngles, count * (math.pi * 2 / 150))
                count = count + 1
            end
        end
        if RingVisualConnection then RingVisualConnection:Disconnect() end
        RingVisualConnection = RunService.Heartbeat:Connect(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for i, part in ipairs(ringVisualParts) do
                if part and part.Parent then
                    pcall(function()
                        local angle = ringVisualAngles[i] + (tick() * ringVisualSpeed)
                        part.Velocity = Vector3.zero
                        part.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle) * ringVisualRadius, 0, math.sin(angle) * ringVisualRadius))
                    end)
                end
            end
        end)
    else
        if RingVisualConnection then RingVisualConnection:Disconnect() end
    end
end)

RingPartsButton.MouseButton1Click:Connect(function()
    RingPartsEnabled = not RingPartsEnabled; setToggleState(RingPartsButton, RingPartsEnabled)
    if RingPartsEnabled then
        ringPartsData.folder = Instance.new("Folder", Workspace)
        local part = Instance.new("Part", ringPartsData.folder)
        part.Anchored = true; part.CanCollide = false; part.Transparency = 1
        ringPartsData.attachment = Instance.new("Attachment", part)
        local sethp = shiddenproperty or set_hidden_property or sethiddenproperty
        if RingPartsConnection then RingPartsConnection:Disconnect() end
        RingPartsConnection = RunService.Heartbeat:Connect(function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and ringPartsData.attachment then
                if sethp then pcall(function() sethp(LocalPlayer, "SimulationRadius", math.huge) end) end
                ringPartsData.attachment.WorldPosition = hrp.Position
                for _, p in pairs(Workspace:GetDescendants()) do
                    if p:IsA("BasePart") and not p.Anchored and p.Parent ~= LocalPlayer.Character then
                        p.CanCollide = false
                        local diff = (p.Position - hrp.Position)
                        if diff.Magnitude < ringPartsConfig.radius then
                            p.Velocity = diff.Unit * -ringPartsConfig.attractionStrength
                        end
                    end
                end
            end
        end)
    else
        if RingPartsConnection then RingPartsConnection:Disconnect() end
        if ringPartsData.folder then ringPartsData.folder:Destroy() end
    end
end)

AimbotButton.MouseButton1Click:Connect(function()
    AimbotEnabled = not AimbotEnabled; setToggleState(AimbotButton, AimbotEnabled)
    if AimbotEnabled then
        if AimbotConnection then AimbotConnection:Disconnect() end
        AimbotConnection = RunService.RenderStepped:Connect(function()
            local target, closest = nil, aimbotFOV
            local centerScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local head = p.Character.Head
                    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - centerScreen).Magnitude
                        if dist < closest then closest = dist target = head end
                    end
                end
            end
            if target then
                local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, aimbotSmoothness)
            end
        end)
    else
        if AimbotConnection then AimbotConnection:Disconnect(); AimbotConnection = nil end
    end
end)

local function setupESP(player)
    if player == LocalPlayer then return end
    local function applyESP()
        if not ESPEnabled then return end
        if player.Character then
            if espObjects[player] then espObjects[player]:Destroy() end
            local hl = Instance.new("Highlight", player.Character)
            hl.FillColor = Theme.Accent
            espObjects[player] = hl
        end
    end
    applyESP()
    if espConnections[player] then espConnections[player]:Disconnect() end
    espConnections[player] = player.CharacterAdded:Connect(applyESP)
end

ESPButton.MouseButton1Click:Connect(function()
    ESPEnabled = not ESPEnabled; setToggleState(ESPButton, ESPEnabled)
    if ESPEnabled then
