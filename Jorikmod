local function updateAccountInfoPanel(userId, username, displayName)
    currentTargetUserId = userId
    UsernameLabel.Text = "@" .. username
    DisplayNameLabel.Text = "Display Name: " .. displayName
    
    local ageText = "N/A дней"
    pcall(function()
        if userId == LocalPlayer.UserId then
            ageText = tostring(LocalPlayer.AccountAge) .. " дней"
        else
            local targetOnServer = Players:GetPlayerByUserId(userId)
            if targetOnServer then
                ageText = tostring(targetOnServer.AccountAge) .. " дней"
            else
                ageText = "Скрыт (Не на сервере)"
            end
        end
    end)
    AccountAgeLabel.Text = "Возраст аккаунта: " .. ageText
    
    if username == "LaVaccaSatty" or username == "ITZ_BECON061" then
        OwnerBadge.Visible = true
    else
        OwnerBadge.Visible = false
    end
    
    local success, content = pcall(function()
        return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    end)
    if success then
        AvatarImage.Image = content
    else
        AvatarImage.Image = "rbxassetid://0"
    end
end

SearchBox.FocusLost:Connect(function()
    local text = SearchBox.Text:gsub("%s+", "")
    if text == "" then
        updateAccountInfoPanel(LocalPlayer.UserId, LocalPlayer.Name, LocalPlayer.DisplayName)
        return
    end
    
    local serverPlayer = nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == text:lower() then
            serverPlayer = p
            break
        end
    end
    
    if serverPlayer then
        updateAccountInfoPanel(serverPlayer.UserId, serverPlayer.Name, serverPlayer.DisplayName)
    else
        task.spawn(function()
            local success, userId = pcall(function()
                return Players:GetUserIdFromNameAsync(text)
            end)
            
            if success and userId then
                local nameSuccess, targetName = pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
                updateAccountInfoPanel(userId, targetName or text, targetName or text)
            else
                SearchBox.Text = "Игрок не найден!"
                task.wait(1.5)
                SearchBox.Text = ""
            end
        end)
    end
end)

