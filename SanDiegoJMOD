local function getFeatureEnvironment()
    if type(getgenv) == "function" then
        local success, environment = pcall(getgenv)
        if success and type(environment) == "table" then return environment end
    end
    return _G
end

local function runFeatureSource(source, chunkName)
    if type(loadstring) ~= "function" then return false, "Executor required" end
    local chunk, compileError = loadstring(source, chunkName)
    if not chunk then return false, compileError end
    local success, runtimeError = pcall(chunk)
    if not success then return false, runtimeError end
    return true
end

local function stopFeature(cleanupName)
    local environment = getFeatureEnvironment()
    local cleanup = environment[cleanupName]
    if type(cleanup) == "function" then pcall(cleanup) end
    return true
end

local borderSpeedLimitEnabled = false
local borderSpeedLimitConfig, borderSpeedLimitOriginalRegion, borderSpeedLimitPatchedRegion

local function startBorderSpeedLimitRemoval()
    if borderSpeedLimitEnabled then return true end
    local configModule = ReplicatedStorage:WaitForChild("SharedModules", 5):WaitForChild("Configs", 5):WaitForChild("RegionSpeedLimits", 5)
    local required, config = pcall(require, configModule)
    if not required or type(config) ~= "table" or type(config.Regions) ~= "table" then return false, "Config error" end
    local originalRegion = config.Regions.BorderSpeedLimitRegion
    if type(originalRegion) ~= "table" then return false, "Region error" end
    
    local patchedRegion = {}
    for k, v in pairs(originalRegion) do patchedRegion[k] = v end
    patchedRegion.MaxMPH = 10000000
    patchedRegion.BrakeTorqueMultiplier = 0
    patchedRegion.NotificationMessageFormat = ""
    patchedRegion.NotificationDuration = 0
    patchedRegion.NotificationMPHOffset = 0
    
    config.Regions.BorderSpeedLimitRegion = patchedRegion
    borderSpeedLimitConfig = config
    borderSpeedLimitOriginalRegion = originalRegion
    borderSpeedLimitPatchedRegion = patchedRegion
    borderSpeedLimitEnabled = true
    return true
end

local function stopBorderSpeedLimitRemoval()
    if borderSpeedLimitConfig and borderSpeedLimitConfig.Regions.BorderSpeedLimitRegion == borderSpeedLimitPatchedRegion then
        pcall(function() borderSpeedLimitConfig.Regions.BorderSpeedLimitRegion = borderSpeedLimitOriginalRegion end)
    end
    borderSpeedLimitConfig, borderSpeedLimitOriginalRegion, borderSpeedLimitPatchedRegion = nil, nil, nil
    borderSpeedLimitEnabled = false
    return true
end

local fuelInfoTables = setmetatable({}, { __mode = "k" })
local lastFuelInfoScan = 0

local function scanGarbageCollectedTables(callback)
    if type(getgc) ~= "function" then return false end
    local success, objects = pcall(getgc, true)
    if not success or type(objects) ~= "table" then return false end
    for _, object in ipairs(objects) do
        if type(object) == "table" then pcall(callback, object) end
    end
    return true
end

local function getDrivenVehicle()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local seat = humanoid and humanoid.SeatPart
    local vehicles = Workspace:FindFirstChild("Vehicles")
    if not seat or not vehicles then return nil, nil end
    local object = seat
    while object and object.Parent ~= vehicles do object = object.Parent end
    if not object or object.Parent ~= vehicles or not object:IsA("Model") then return nil, nil end
    local root = object:FindFirstChild("Root") or object.PrimaryPart or seat.AssemblyRootPart
    return object, root
end

local function patchVehicleFuel(vehicle, root)
    if not vehicle or not vehicle.Parent then return false end
    local maxFuel = vehicle:GetAttribute("MaxFuel") or vehicle:GetAttribute("Fuel") or 100
    pcall(function()
        vehicle:SetAttribute("CurrentFuel", maxFuel)
        vehicle:SetAttribute("Fuel", maxFuel)
    end)
    if lastFuelInfoScan == 0 or os.clock() - lastFuelInfoScan >= 1 then
        lastFuelInfoScan = os.clock()
        scanGarbageCollectedTables(function(object)
            if type(rawget(object, "CurrentFuel")) == "number" and type(rawget(object, "MaxFuel")) == "number" and typeof(rawget(object, "Root")) == "Instance" then
                fuelInfoTables[object] = true
            end
        end)
    end
    for object in pairs(fuelInfoTables) do
        if rawget(object, "Root") == root then
            object.CurrentFuel = maxFuel
            object.MaxFuel = maxFuel
        end
    end
    return true
end

local disabledPitConnections = {}

local function disableSignalConnections(signal, registry)
    local resolved = type(getconnections) == "function" and getconnections
    if not resolved then return false end
    local success, signalConnections = pcall(resolved, signal)
    if not success then return false end
    for _, connection in ipairs(signalConnections) do
        pcall(function()
            connection:Disable()
            registry[connection] = true
        end)
    end
    return true
end

local function enableSignalConnections(registry)
    for connection in pairs(registry) do
        pcall(function() connection:Enable() end)
        registry[connection] = nil
    end
end

local function refreshAntiPitConnections()
    local remotes = ReplicatedStorage:FindFirstChild("__remotes")
    local vehicleService = remotes and remotes:FindFirstChild("VehicleService")
    local remote = vehicleService and vehicleService:FindFirstChild("VehiclePitManeuver")
    if not remote then return false end
    return disableSignalConnections(remote.OnClientEvent, disabledPitConnections)
end

local movementController, staminaGetter, staminaUpvalueIndex, staminaSetupValue

local function resolveStaminaUpvalue()
    if staminaGetter and staminaUpvalueIndex and staminaSetupValue then return true end
    local success, controller = pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("MovementController"))
    end)
    if not success then return false end
    local debugLibrary = debug
    local getUpvalues = (debugLibrary and debugLibrary.getupvalues) or getupvalues
    local setupValue = (debugLibrary and debugLibrary.setupvalue) or setupvalue
    if type(getUpvalues) ~= "function" or type(setupValue) ~= "function" then return false end
    local gotUpvalues, upvalues = pcall(getUpvalues, controller.GetStamina)
    if not gotUpvalues then return false end
    local currentStamina = controller:GetStamina()
    for index, value in pairs(upvalues) do
        if type(index) == "number" and type(value) == "number" and math.abs(value - currentStamina) < 0.001 then
            movementController = controller
            staminaGetter = controller.GetStamina
            staminaUpvalueIndex = index
            staminaSetupValue = setupValue
            return true
        end
    end
    return false
end

local function refillStamina()
    if not resolveStaminaUpvalue() then return false end
    return pcall(staminaSetupValue, staminaGetter, staminaUpvalueIndex, 200)
end

