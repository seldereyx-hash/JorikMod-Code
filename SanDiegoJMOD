local function applyBorders(btn)
	if not btn then return end
	btn:GetPropertyChangedSignal("Position"):Connect(function()
		local screenX = Camera.ViewportSize.X
		local screenY = Camera.ViewportSize.Y
		local btnX = btn.AbsolutePosition.X
		local btnY = btn.AbsolutePosition.Y
		local sizeX = btn.AbsoluteSize.X
		local sizeY = btn.AbsoluteSize.Y
		
		local clampedX = math.clamp(btnX, 0, screenX - sizeX)
		local clampedY = math.clamp(btnY, 0, screenY - sizeY)
		
		if btnX ~= clampedX or btnY ~= clampedY then
			btn.Position = UDim2.fromOffset(clampedX, clampedY)
		end
	end)
end

