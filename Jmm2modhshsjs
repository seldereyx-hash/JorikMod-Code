local function applyBorders(btn)
    if not btn then return end
    btn:GetPropertyChangedSignal("Position"):Connect(function()
        local screenX = Camera.ViewportSize.X
        local screenY = Camera.ViewportSize.Y
        local btnX = btn.AbsolutePosition.X
        local btnY = btn.AbsolutePosition.Y
        local sizeX = btn.AbsoluteSize.X
        local sizeY = btn.AbsoluteSize.Y
        
        local clampedX = math.clamp(btnX, 0, screenX - sizeX)
        local clampedY = math.clamp(btnY, 0, screenY - sizeY)
        
        if btnX ~= clampedX or btnY ~= clampedY then
            btn.Position = UDim2.fromOffset(clampedX, clampedY)
        end
    end)
end

if openButtonFrame then
    applyBorders(openButtonFrame)
end

local isUiOpen = true
local isTweening = false

local function setVisibility(state)
    if isTweening then return end
    isTweening = true
    isUiOpen = state
    
    local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    
    if isUiOpen then
        if openButtonFrame then
            TweenService:Create(openButtonFrame, tInfo, {Size = UDim2.fromScale(0, 0)}):Play()
        end
        mainGui.Enabled = true
        local openTween = TweenService:Create(mainGui.CanvasGroup, tInfo, {GroupTransparency = 0})
        openTween:Play()
        openTween.Completed:Connect(function() isTweening = false end)
    else
        if openButtonFrame then
            TweenService:Create(openButtonFrame, tInfo, {Size = UDim2.fromOffset(60, 60)}):Play()
        end
        local closeTween = TweenService:Create(mainGui.CanvasGroup, tInfo, {GroupTransparency = 1})
        closeTween:Play()
        closeTween.Completed:Connect(function()
            mainGui.Enabled = false
            isTweening = false
        end)
    end
end

UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == currentKey then
