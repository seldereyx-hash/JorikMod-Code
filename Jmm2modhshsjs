local function getRole(player)
	if not player.Character then return "Innocent" end
	
	for _, item in ipairs(player.Character:GetChildren()) do
		if item:IsA("Tool") then
			if item.Name == "Knife" then
				return "Murderer"
			elseif item.Name == "Gun" or item.Name == "Revolver" then
				return "Sheriff"
			end
		end
	end
	
	if player:FindFirstChild("Backpack") then
		local backpack = player.Backpack
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				if item.Name == "Knife" then
					return "Murderer"
				elseif item.Name == "Gun" or item.Name == "Revolver" then
					return "Sheriff"
				end
			end
		end
	end
	
	for _, p in ipairs(Workspace:GetChildren()) do
		if p:IsA("Model") and p.Name == player.Name then
			for _, item in ipairs(p:GetChildren()) do
				if item:IsA("Tool") then
					if item.Name == "Knife" then
						return "Murderer"
					elseif item.Name == "Gun" or item.Name == "Revolver" then
						return "Sheriff"
					end
				end
			end
		end
	end
	
	if player:GetAttribute("Role") == "Murderer" then return "Murderer" end
	if player:GetAttribute("Role") == "Sheriff" then return "Sheriff" end
	if player:GetAttribute("Role") == "Hero" then return "Hero" end
	
	return "Innocent"
end

local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local highlight = player.Character:FindFirstChild("MM2Highlight")
			if espEnabled then
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.Name = "MM2Highlight"
					highlight.Parent = player.Character
				end
				
				local role = getRole(player)
				if role == "Murderer" then
					highlight.FillColor = Color3.fromRGB(255, 0, 0)
				elseif role == "Sheriff" then
					highlight.FillColor = Color3.fromRGB(0, 0, 255)
				elseif role == "Hero" then
					highlight.FillColor = Color3.fromRGB(255, 255, 0)
				else
					highlight.FillColor = Color3.fromRGB(0, 255, 0)
				end
				highlight.Enabled = true
			else
				if highlight then
					highlight.Enabled = false
				end
			end
		end
	end
end

